DATABASE_URL="postgresql://user:password@localhost:5432/spot_check_test?schema=public"

# The integration tests hit this database for real (PostGIS queries aren't
# meaningfully testable against a mock) and run prisma/seed.ts against it,
# which wipes all tables — point this at a disposable database, never at
# spot_check_dev or anything with real-looking data.
SEED_ALLOW_RESET=true
