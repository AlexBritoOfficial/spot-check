DATABASE_URL="postgresql://user:password@localhost:5432/spot_check_dev?schema=public"

# Required by prisma/seed.ts before it will wipe/reseed the database DATABASE_URL
# points at. Set this locally; never set it against a database with real user data.
SEED_ALLOW_RESET=true

# Running `npm test` locally needs its own disposable database (the
# integration test runs real PostGIS queries) — see .env.test.example,
# copy it to .env.test and point it at a separate database, not this one.

# Required by src/app/api/upload/route.ts to store spot photos in Vercel
# Blob. Don't set this by hand — create/connect the Blob store (see the
# setup wizard) then run `vercel env pull .env.local` to get the real value.
BLOB_READ_WRITE_TOKEN=
